{
  "name": "blaze/admin-core",
  "description": "Core Admin Panel for Blaze applications",
  "type": "library",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Blaze\\AdminCore\\": "src/",
      "Blaze\\AdminCore\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Blaze\\AdminCore\\Providers\\AdminCoreServiceProvider"
      ]
    }
  }
}
